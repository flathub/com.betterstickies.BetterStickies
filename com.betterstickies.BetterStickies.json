{
  "app-id": "com.betterstickies.BetterStickies",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "26.08",
  "sdk": "org.freedesktop.Sdk",
  "command": "betterstickies",
  "finish-args": [
    "--share=ipc",
    "--share=network",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--device=dri",
    "--socket=pulseaudio",
    "--talk-name=org.kde.StatusNotifierWatcher",
    "--talk-name=org.kde.KWin",
    "--filesystem=xdg-desktop:ro",
    "--filesystem=xdg-documents:ro",
    "--filesystem=xdg-download:ro",
    "--filesystem=xdg-pictures:ro"
  ],
  "modules": [
    {
      "name": "betterstickies",
      "buildsystem": "simple",
      "build-commands": [
        "cp -a betterstickies /app/betterstickies",
        "install -Dm755 betterstickies-wrapper /app/bin/betterstickies",
        "install -Dm644 betterstickies/usr/share/applications/com.betterstickies.BetterStickies.desktop /app/share/applications/com.betterstickies.BetterStickies.desktop",
        "desktop-file-edit --set-key=Exec --set-value=betterstickies /app/share/applications/com.betterstickies.BetterStickies.desktop",
        "install -Dm644 betterstickies/usr/share/metainfo/com.betterstickies.BetterStickies.metainfo.xml /app/share/metainfo/com.betterstickies.BetterStickies.metainfo.xml",
        "for size in 64 128 256 512; do install -Dm644 betterstickies/usr/share/icons/hicolor/${size}x${size}/apps/com.betterstickies.BetterStickies.png /app/share/icons/hicolor/${size}x${size}/apps/com.betterstickies.BetterStickies.png; done"
      ],
      "sources": [
        {
          "type": "archive",
          "only-arches": [
            "x86_64"
          ],
          "url": "https://github.com/HimaSphere/BetterStickies/releases/download/v1.5.1/BetterStickies_1.5.1-x86_64.tar.gz",
          "sha256": "5407f40bdee1b12a63596e55932ed43a33a5bfffe7458053fd6d89fbd059088e",
          "dest": "betterstickies",
          "strip-components": 0,
          "x-checker-data": {
            "type": "json",
            "url": "https://api.github.com/repos/HimaSphere/BetterStickies/releases?per_page=100",
            "version-query": "[.[] | select((.draft or .prerelease) | not) | select(any(.assets[]; .name | test(\"^BetterStickies.*-x86_64[.]tar[.]gz$\")))] | first | .tag_name | sub(\"^v\"; \"\")",
            "url-query": "[.[] | select((.draft or .prerelease) | not) | .assets[] | select(.name | test(\"^BetterStickies.*-x86_64[.]tar[.]gz$\"))] | first | .browser_download_url"
          }
        },
        {
          "type": "archive",
          "only-arches": [
            "aarch64"
          ],
          "url": "https://github.com/HimaSphere/BetterStickies/releases/download/v1.5.1/BetterStickies_1.5.1-aarch64.tar.gz",
          "sha256": "72443de903fb63bfa730657197bf734df2049af624ee82bc026b19164f184be9",
          "dest": "betterstickies",
          "strip-components": 0,
          "x-checker-data": {
            "type": "json",
            "url": "https://api.github.com/repos/HimaSphere/BetterStickies/releases?per_page=100",
            "version-query": "[.[] | select((.draft or .prerelease) | not) | select(any(.assets[]; .name | test(\"^BetterStickies.*-aarch64[.]tar[.]gz$\")))] | first | .tag_name | sub(\"^v\"; \"\")",
            "url-query": "[.[] | select((.draft or .prerelease) | not) | .assets[] | select(.name | test(\"^BetterStickies.*-aarch64[.]tar[.]gz$\"))] | first | .browser_download_url"
          }
        },
        {
          "type": "script",
          "dest-filename": "betterstickies-wrapper",
          "commands": [
            "exec /app/betterstickies/AppRun \"$@\""
          ]
        }
      ]
    }
  ]
}
